[
 {
  "name": "orders basic measures",
  "query": {
   "measures": [
    "orders.count",
    "orders.customer_count",
    "orders.revenue",
    "orders.avg_amount",
    "orders.min_amount",
    "orders.max_amount",
    "orders.average_order_value"
   ],
   "dimensions": [
    "orders.status"
   ]
  }
 },
 {
  "name": "orders string time boolean measures",
  "query": {
   "measures": [
    "orders.first_order_at",
    "orders.has_returns",
    "orders.statuses_seen"
   ],
   "dimensions": [
    "orders.status_group"
   ]
  }
 },
 {
  "name": "orders number_agg",
  "query": {
   "measures": [
    "orders.median_customer_revenue"
   ],
   "dimensions": [
    "orders.status"
   ]
  }
 },
 {
  "name": "orders filtered measures from macro",
  "query": {
   "measures": [
    "orders.new_count",
    "orders.returned_revenue",
    "orders.completed_count",
    "orders.high_value_completed_revenue",
    "orders.return_rate"
   ]
  }
 },
 {
  "name": "orders custom granularity",
  "query": {
   "measures": [
    "orders.count"
   ],
   "timeDimensions": [
    {
     "dimension": "orders.ordered_at",
     "granularity": "fiscal_quarter"
    }
   ]
  }
 },
 {
  "name": "orders boolean dimension and segment",
  "query": {
   "measures": [
    "orders.count"
   ],
   "dimensions": [
    "orders.is_high_value"
   ],
   "segments": [
    "orders.completed"
   ]
  }
 },
 {
  "name": "orders join customers",
  "query": {
   "measures": [
    "orders.revenue"
   ],
   "dimensions": [
    "customers.region",
    "orders.customer_region"
   ]
  }
 },
 {
  "name": "orders rolling window",
  "query": {
   "measures": [
    "orders.revenue_trailing_7_days",
    "orders.cumulative_revenue",
    "orders.revenue_year_to_date"
   ],
   "timeDimensions": [
    {
     "dimension": "orders.ordered_at",
     "granularity": "month",
     "dateRange": [
      "2026-01-01",
      "2026-06-30"
     ]
    }
   ]
  }
 },
 {
  "name": "orders time_shift",
  "query": {
   "measures": [
    "orders.revenue",
    "orders.revenue_prior_month",
    "orders.revenue_month_over_month"
   ],
   "timeDimensions": [
    {
     "dimension": "orders.ordered_at",
     "granularity": "month",
     "dateRange": [
      "2026-01-01",
      "2026-06-30"
     ]
    }
   ]
  }
 },
 {
  "name": "orders reduce_by group_by rank",
  "query": {
   "measures": [
    "orders.revenue",
    "orders.revenue_all_statuses",
    "orders.revenue_share_of_statuses",
    "orders.revenue_of_status_group",
    "orders.status_revenue_rank"
   ],
   "dimensions": [
    "orders.status",
    "orders.status_group"
   ]
  }
 },
 {
  "name": "orders switch case measure",
  "query": {
   "measures": [
    "orders.revenue_in_unit"
   ],
   "dimensions": [
    "orders.amount_unit"
   ]
  }
 },
 {
  "name": "orders calendar named time_shift",
  "query": {
   "measures": [
    "orders.revenue",
    "orders.revenue_prior_fiscal_year"
   ],
   "timeDimensions": [
    {
     "dimension": "calendar.date",
     "granularity": "year"
    }
   ]
  }
 },
 {
  "name": "calendar granularity override",
  "query": {
   "measures": [
    "orders.count"
   ],
   "dimensions": [
    "calendar.fiscal_year"
   ],
   "timeDimensions": [
    {
     "dimension": "calendar.date",
     "granularity": "quarter"
    }
   ]
  }
 },
 {
  "name": "customers geo and sub_query",
  "query": {
   "measures": [
    "customers.count"
   ],
   "dimensions": [
    "customers.region",
    "customers.region_location",
    "customers.lifetime_tier",
    "customers.lifetime_revenue"
   ]
  }
 },
 {
  "name": "customers segment",
  "query": {
   "measures": [
    "customers.count",
    "customers.region_count"
   ],
   "segments": [
    "customers.emea"
   ]
  }
 },
 {
  "name": "products measures",
  "query": {
   "measures": [
    "products.count",
    "products.active_count",
    "products.avg_price",
    "products.stock_value",
    "products.active_ratio"
   ],
   "dimensions": [
    "products.category",
    "products.price_band"
   ]
  }
 },
 {
  "name": "products one_to_one hidden cube",
  "query": {
   "measures": [
    "product_snapshots.snapshot_stock_quantity"
   ],
   "dimensions": [
    "products.name",
    "product_snapshots.snapshot_price"
   ]
  }
 },
 {
  "name": "order_items joins",
  "query": {
   "measures": [
    "order_items.count",
    "order_items.gross_amount",
    "order_items.net_amount",
    "order_items.products_sold",
    "order_items.products_sold_approx"
   ],
   "dimensions": [
    "products.category",
    "orders.status"
   ]
  }
 },
 {
  "name": "events FILTER_PARAMS and FILTER_GROUP",
  "query": {
   "measures": [
    "events.count",
    "events.signup_count",
    "events.purchase_amount",
    "events.signup_to_purchase_rate"
   ],
   "dimensions": [
    "events.name",
    "events.plan"
   ],
   "filters": [
    {
     "or": [
      {
       "member": "events.name",
       "operator": "equals",
       "values": [
        "signup",
        "purchase"
       ]
      },
      {
       "member": "events.event_at",
       "operator": "afterDate",
       "values": [
        "2026-01-01"
       ]
      }
     ]
    }
   ]
  }
 },
 {
  "name": "events custom granularity",
  "query": {
   "measures": [
    "events.count"
   ],
   "timeDimensions": [
    {
     "dimension": "events.event_at",
     "granularity": "week_starting_on_sunday"
    }
   ],
   "segments": [
    "events.purchases"
   ]
  }
 },
 {
  "name": "extends cube",
  "query": {
   "measures": [
    "products_snapshot_extended.count",
    "products_snapshot_extended.total_weight"
   ],
   "dimensions": [
    "products_snapshot_extended.category"
   ]
  }
 },
